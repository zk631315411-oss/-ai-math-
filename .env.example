# JWT 密钥 (必填)
JWT_SECRET=your_jwt_secret_here

# LLM API 配置 (必填)
LLM_API_KEY=your_api_key_here
LLM_API_BASE=https://api.anthropic.com
LLM_MODEL=claude-sonnet-4-20250514

# Embedding API 配置 (必填)
EMBEDDING_API_KEY=your_api_key_here
EMBEDDING_MODEL=text-embedding-3-small

# Neo4j 连接配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# 知识图谱构建用LLM（智谱 GLM）
ZHIPU_API_KEY=your_zhipu_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key

# OCR 配置 (可选)
OCR_ENABLED=false
OCR_API_KEY=

# 认知诊断 V2：shadow / stage_only / full
DIAGNOSIS_V2_MODE=shadow
DIALOGUE_STATE_MODE=shadow
DIALOGUE_STATE_MODEL_VERSION=ordinal-bayes-v1

# Optional database override for isolated tests
# AI_MATH_DB_PATH=data/test-learning.db
