# JWT 密钥 (必填)
JWT_SECRET=your_jwt_secret_here

# LLM API 配置 (必填)
LLM_API_KEY=your_api_key_here
LLM_API_BASE=https://api.anthropic.com
LLM_MODEL=claude-sonnet-4-20250514

# Embedding API 配置 (必填)
EMBEDDING_API_KEY=your_api_key_here
EMBEDDING_MODEL=text-embedding-3-small

# Neo4j 连接配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# 知识图谱构建用LLM（智谱 GLM）
ZHIPU_API_KEY=your_zhipu_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key

# OCR 配置 (可选)
OCR_ENABLED=false
OCR_API_KEY=

# 认知诊断 V2：shadow / stage_only / full
DIAGNOSIS_V2_MODE=shadow
DIALOGUE_STATE_MODE=shadow
DIALOGUE_STATE_MODEL_VERSION=ordinal-bayes-v1

# Tool Runtime reliability limits (whole-turn timeouts remain disabled by default)
TOOL_MAX_MODEL_ROUNDS=5
TOOL_MAX_TOTAL_CALLS=8
TOOL_DEFAULT_TIMEOUT_SECONDS=15
TOOL_MAX_CONSECUTIVE_FAILURE_ROUNDS=2
VISION_EXTRACTION_CONFIDENCE=0.70
QA_TEXT_TURN_TIMEOUT_SECONDS=0
QA_SCREENSHOT_TURN_TIMEOUT_SECONDS=0

# 数学动画（Redis/RQ + S3兼容对象存储）
VISUALIZATION_REDIS_URL=redis://localhost:6379/0
VISUALIZATION_QUEUE=math-visualization
VISUALIZATION_S3_ENDPOINT=http://localhost:9000
VISUALIZATION_S3_REGION=us-east-1
VISUALIZATION_S3_BUCKET=ai-math-visualizations
VISUALIZATION_S3_ACCESS_KEY=minioadmin
VISUALIZATION_S3_SECRET_KEY=minioadmin
VISUALIZATION_URL_TTL_SECONDS=900
VISUALIZATION_MAX_OUTPUT_BYTES=26214400
VISUALIZATION_WORKER_CONCURRENCY=1

# Optional database override for isolated tests
# AI_MATH_DB_PATH=data/test-learning.db
# Formula conversion providers (local -> Cloudflare -> existing model)
# Local llama-server must listen on loopback only, for example http://127.0.0.1:8080/v1
FORMULA_LOCAL_API_BASE=
FORMULA_LOCAL_API_KEY=local
FORMULA_LOCAL_MODEL=
FORMULA_CLOUDFLARE_ACCOUNT_ID=
FORMULA_CLOUDFLARE_API_TOKEN=
FORMULA_CLOUDFLARE_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
# Leave these empty to inherit PROFILE_LLM_* values.
FORMULA_EXISTING_API_BASE=
FORMULA_EXISTING_API_KEY=
FORMULA_EXISTING_MODEL=
FORMULA_CONVERSION_TIMEOUT_SECONDS=8

# Use DELETE when a Windows-hosted SQLite file is bind-mounted into a Linux Worker.
AI_MATH_DB_JOURNAL_MODE=WAL
