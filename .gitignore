# --- Python 环境产物 ---
__pycache__/
*.pyc
venv/
.pytest_cache/

# --- 密钥与配置 ---
.env

# --- 前端构建产物 ---
node_modules/
frontend/dist/
frontend/test-results/
frontend/tsconfig.tsbuildinfo

# --- 本地工具工作区 ---
.agents/
.claude/
.codex-tmp/
.vscode/
.opencode/
.understand-anything/

# --- 数据库文件（从服务器恢复，不提交） ---
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# --- 截图裁剪缓存 ---
data/screenshot_crops/*
!data/screenshot_crops/.gitkeep

# --- 临时/运行时产物 ---
.tmp/
playwright-report/
debug_content.txt
*.lnk
frontend/debug-*.png

# --- 大体积PDF教材（超过 GitHub 100MB 限制） ---
frontend/public/*.pdf

# --- KG 构建归档（历史中间产物，体积大） ---
教材提取模块/正式脚本/归档/
教材提取模块/高代提取/归档/
教材提取模块/高代提取/正式_runs/
教材提取模块/高代提取/中间产物/
教材提取模块/高数提取/归档/
教材提取模块/高数提取/正式旧_runs/

# --- pipeline 运行时产物 ---
pipeline/.venv/
pipeline/venv/
pipeline/__pycache__/