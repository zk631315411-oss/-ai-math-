    "diagnostic_goal": "proof",
    "difficulty": "advanced",
    "question": "证明：矩阵 A 的任意一个子矩阵的秩不会超过 A 的秩。",
    "answer_spec": {
      "reference": "设 B 是 A 的任意子矩阵，记 r=rank(B)。若 r=0，结论显然。若 r>0，则 B 中存在一个非零的 r 阶子式；这个子式也是 A 的一个 r 阶子式，所以 rank(A)≥r=rank(B)。",
      "accepted_keywords": ["rank(B)", "非零", "r 阶", "rank(A)"]
    },
    "hints": [
      "先写出矩阵秩由非零子式刻画的判据。",
      "设 B 的秩为 r，想想 B 中必然存在怎样的 r 阶子式。",
      "B 的这个非零子式也是 A 的子式，再比较两个秩。"
    ],
    "rubric": [
      {"criterion": "设定对象", "required": true, "description": "令 B 为 A 的任意子矩阵并记 r=rank(B)。"},
      {"criterion": "调用秩的判据", "required": true, "description": "指出 B 存在非零 r 阶子式。"},
      {"criterion": "建立包含关系", "required": true, "description": "说明该子式也是 A 的 r 阶子式。"},
      {"criterion": "完成结论", "required": true, "description": "推出 rank(A)≥rank(B)，并覆盖 r=0。"}
    ],
