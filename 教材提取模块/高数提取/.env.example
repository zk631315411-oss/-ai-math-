# OpenAI-compatible API settings.
# Copy this file to .env or pass it with --env-file, then fill real values locally.

OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://your-openai-compatible-base-url/v1

LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://your-openai-compatible-base-url/v1

DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_API_BASE=https://your-openai-compatible-base-url/v1

OPENAI_DEFAULT_MODEL=gpt-5.4
OPENAI_SUMMARY_MODEL=gpt-5.4-mini
OPENAI_NODE_MODEL=gpt-5.4
OPENAI_EDGE_MODEL=gpt-5.5
OPENAI_RULE_CASE_MODEL=gpt-5.5
OPENAI_NODE_AUDIT_MODEL=gpt-5.5
OPENAI_RELATION_AUDIT_MODEL=gpt-5.5
OPENAI_REVIEW_MODEL=gpt-5.5
OPENAI_CONFLICT_REVIEW_MODEL=gpt-5.5
OPENAI_HIGH_RISK_MODEL=gpt-5.5

# Set false only for a local/trusted compatible gateway with certificate hostname mismatch.
LLM_VERIFY_SSL=false

